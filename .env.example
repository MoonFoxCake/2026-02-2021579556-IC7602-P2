# Optional local Compose overrides. No .env or Firebase credentials are needed to start.
# These defaults are public demo credentials for the loopback-only emulator stack.
LOCAL_DEMO_EMAIL=demo@p2.test
LOCAL_DEMO_PASSWORD=local-demo-password
LOCAL_JWT_SECRET=local-emulator-only-jwt-secret-at-least-32-chars
LOCAL_SERVICE_KEY=local-emulator-only-service-key
# Seeding is create-only. Changing an existing demo password requires resetting the emulator data.
# Production Firebase/Vercel settings are documented separately in api-nodejs/README.md.
