# Copiar a ZonalCache/.env (NO subir el .env a GitHub) y completar. Lo lee scripts/deploy-k8s.sh.

# Base del API Node.js desplegado en Vercel (sin / al final)
ZC_CONFIG_URL=https://<su-api>.vercel.app
# El DNS Interceptor llama a este mismo API; si se omite, usa ZC_CONFIG_URL.
DNS_API_URL=
# Debe ser igual a SERVICE_KEY en las variables de entorno del proyecto de Vercel
ZC_CONFIG_TOKEN=
# local = la caché muestra su formulario; ui = redirige al formulario del UI (requiere el ticket firmado)
ZC_LOGIN_MODE=local
ZC_LOGIN_UI_URL=
# Solo modo ui: >= 32 caracteres, igual a TICKET_SECRET del API
ZC_TICKET_SECRET=

ZONES="cr us"
NAMESPACE=default
IMAGE=zonal-cache:dev
SERVICE_TYPE=LoadBalancer
TLS_CN=ejemplo.com
