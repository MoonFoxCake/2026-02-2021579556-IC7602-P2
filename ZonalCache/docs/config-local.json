{
  "domains": [
    {
      "domain": "ejemplo.com",
      "origin": "http://127.0.0.1:9800",
      "maxCacheBytes": 1048576,
      "urls": [
        { "pattern": "/*", "auth": { "mode": "none" },
          "fileTypes": [ { "ext": "html", "ttl": 60,   "policy": "LRU" },
                         { "ext": "png",  "ttl": 3600, "policy": "LFU" },
                         { "ext": "txt",  "ttl": 30,   "policy": "FIFO" } ] },
        { "pattern": "/api/*", "origin": "http://127.0.0.1:9801",
          "auth": { "mode": "apikey", "apiKeyHashes": ["24b736a20d41ea486019f1751b0270c70cab0d6e137a490b8bd8da2d988803ec"] },
          "fileTypes": [ { "ext": "json", "ttl": 20, "policy": "MRU" } ] },
        { "pattern": "/privado/*", "cacheBytes": 4096, "auth": { "mode": "userpass" },
          "fileTypes": [ { "ext": "*", "ttl": 120, "policy": "RANDOM" } ] }
      ]
    },
    {
      "domain": "externo-http.com",
      "origin": "http://example.com",
      "maxCacheBytes": 1048576,
      "urls": [ { "pattern": "/*", "auth": { "mode": "none" }, "fileTypes": [ { "ext": "*", "ttl": 300, "policy": "LRU" } ] } ]
    },
    {
      "domain": "externo-https.com",
      "origin": "https://example.com",
      "maxCacheBytes": 1048576,
      "urls": [ { "pattern": "/*", "auth": { "mode": "none" }, "fileTypes": [ { "ext": "*", "ttl": 300, "policy": "LRU" } ] } ]
    }
  ]
}
