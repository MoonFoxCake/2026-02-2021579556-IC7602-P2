{
  "domains": [
    {
      "domain": "ejemplo.com",
      "origin": "https://ejemplo.com",
      "maxCacheBytes": 104857600,
      "urls": [
        { "pattern": "/*", "auth": { "mode": "none" },
          "fileTypes": [ { "ext": "html", "ttl": 60, "policy": "LRU" },
                         { "ext": "png",  "ttl": 3600, "policy": "LFU" },
                         { "ext": "*",    "ttl": 30, "policy": "FIFO" } ] },
        { "pattern": "/api/*", "auth": { "mode": "apikey",
            "apiKeyHashes": ["<sha256 hex de la API key>"] },
          "fileTypes": [ { "ext": "json", "ttl": 20, "policy": "MRU" } ] },
        { "pattern": "/privado/*", "cacheBytes": 5242880, "auth": { "mode": "userpass" },
          "fileTypes": [ { "ext": "*", "ttl": 120, "policy": "RANDOM" } ] }
      ]
    }
  ]
}
