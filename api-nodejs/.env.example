# Copia este archivo a .env y completa los valores (o usa: npm run env:from-json -- ruta/al/archivo.json)
# NUNCA subas el .env real a GitHub. En Vercel estas mismas variables se configuran en
# Project Settings > Environment Variables.

# Credenciales de la cuenta de servicio de Firebase (salen del JSON descargado)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
# La clave va entre comillas dobles y con los saltos de linea escritos como \n
FIREBASE_PRIVATE_KEY=

# --- Autenticacion de la UI (src/auth.js) ---
# Secreto para firmar los tokens JWT. Minimo 32 caracteres, aleatorio.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Vida del token en segundos (opcional, por defecto 3600)
# JWT_EXPIRES_IN=3600
# Origenes de la UI permitidos por CORS, separados por coma (src/cors.js)
CORS_ORIGINS=https://proyecto-redes-2.vercel.app,http://localhost:5173

# --- Servicio (cachés zonales e interceptor) ---
SERVICE_KEY=
ZONE_CACHES=cr=10.1.1.1,us=10.2.2.2
COUNTRY_ZONES=CR=cr,US=us,*=us
# Realtime Database /ipToCountry: import P1's numeric ranges with npm run ip-country:import.
# Same random secret as ZC_TICKET_SECRET in Kubernetes, at least 32 characters.
TICKET_SECRET=
# CACHE_LOGIN_ALLOW_HTTP=1 # localhost/isolated HTTP demos only; HTTPS callbacks by default.

# --- Panel Acceso a caché (opcional; destinos fijos alcanzables desde el API) ---
# CACHE_TEST_URLS={"cr":"https://redes-panel-cr.example.com","us":"https://redes-panel-us.example.com"}
# CACHE_TEST_TUNNEL_KEY= # Clave hex aleatoria de 64 caracteres, igual al gateway; solo backend.
# CACHE_TEST_LOGIN_MODE=ui # Usa TICKET_SECRET y el handoff firmado; local es el modo Compose.
# CACHE_TEST_COOKIE_SECURE=1
# CACHE_TEST_URL=http://zonal-cache:8080 # Alternativa de una zona para Compose.
