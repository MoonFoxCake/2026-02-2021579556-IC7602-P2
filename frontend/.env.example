# Include the Node API's /api prefix. For local development:
VITE_API_BASE_URL=http://localhost:3000/api
# Vercel frontend Production value (requires a new build/deployment):
# VITE_API_BASE_URL=/api
# API_PROXY_ORIGIN=https://<node-api-project>.vercel.app
# API_PROXY_ORIGIN is deployment configuration, not a VITE_ browser variable.
